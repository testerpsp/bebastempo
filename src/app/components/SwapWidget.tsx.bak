'use client'

import { useState, useEffect } from 'react'
import { useAccount, useWriteContract, useReadContract, useBalance } from 'wagmi'
import { ConnectButton } from '@rainbow-me/rainbowkit'
import { maxUint256, formatUnits } from 'viem'

const DEX_ADDRESS = '0xdec0000000000000000000000000000000000000' as `0x${string}`

const TOKENS = {
  pathUSD: '0x20c0000000000000000000000000000000000000' as `0x${string}`,
  AlphaUSD: '0x20c0000000000000000000000000000000000001' as `0x${string}`,
  BetaUSD: '0x20c0000000000000000000000000000000000002' as `0x${string}`,
  ThetaUSD: '0x20c0000000000000000000000000000000000003' as `0x${string}`,
}

const DEX_ABI = [
  {
    type: 'function',
    name: 'swapExactAmountIn',
    stateMutability: 'nonpayable',
    inputs: [
      { type: 'address', name: 'tokenIn' },
      { type: 'address', name: 'tokenOut' },
      { type: 'uint128', name: 'amountIn' },
      { type: 'uint128', name: 'minAmountOut' },
    ],
    outputs: [{ type: 'uint128', name: 'amountOut' }],
  },
  {
    type: 'function',
    name: 'quoteSwapExactAmountIn',
    stateMutability: 'view',
    inputs: [
      { type: 'address', name: 'tokenIn' },
      { type: 'address', name: 'tokenOut' },
      { type: 'uint128', name: 'amountIn' },
    ],
    outputs: [{ type: 'uint128', name: 'amountOut' }],
  },
] as const

const ERC20_ABI = [
  {
    type: 'function',
    name: 'allowance',
    stateMutability: 'view',
    inputs: [
      { type: 'address', name: 'owner' },
      { type: 'address', name: 'spender' },
    ],
    outputs: [{ type: 'uint256', name: '' }],
  },
  {
    type: 'function',
    name: 'approve',
    stateMutability: 'nonpayable',
    inputs: [
      { type: 'address', name: 'spender' },
      { type: 'uint256', name: 'amount' },
    ],
    outputs: [{ type: 'bool', name: '' }],
  },
  {
    type: 'function',
    name: 'balanceOf',
    stateMutability: 'view',
    inputs: [{ type: 'address', name: 'account' }],
    outputs: [{ type: 'uint256', name: '' }],
  },
] as const

// Token Balance Component
function TokenBalance({ address, tokenAddress, tokenName }: { address: `0x${string}`, tokenAddress: `0x${string}`, tokenName: string }) {
  const { data: balance } = useReadContract({
    address: tokenAddress,
    abi: ERC20_ABI,
    functionName: 'balanceOf',
    args: [address],
    query: {
      refetchInterval: 5000, // Refetch every 5 seconds
    },
  })

  const formattedBalance = balance ? (Number(balance) / 1e6).toFixed(6) : '0.000000'

  return (
    <div className="flex items-center justify-between p-3 bg-gray-800/50 rounded-lg border border-gray-700 hover:bg-gray-800 transition">
      <div className="flex items-center gap-3">
        <div className="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-white font-bold text-sm">
          {tokenName.slice(0, 2)}
        </div>
        <div>
          <p className="text-white font-medium text-sm">{tokenName}</p>
          <p className="text-gray-400 text-xs">Balance</p>
        </div>
      </div>
      <div className="text-right">
        <p className="text-white font-bold text-sm">{formattedBalance}</p>
      </div>
    </div>
  )
}

// Custom Dropdown Component
function TokenSelect({ 
  value, 
  onChange, 
  label 
}: { 
  value: keyof typeof TOKENS
  onChange: (token: keyof typeof TOKENS) => void
  label: string
}) {
  const [isOpen, setIsOpen] = useState(false)

  const handleSelect = (token: keyof typeof TOKENS) => {
    onChange(token)
    setIsOpen(false)
  }

  return (
    <div className="relative shrink-0" style={{ zIndex: isOpen ? 9999 : 1 }}>
      <button
        type="button"
        onClick={(e) => {
          e.preventDefault()
          e.stopPropagation()
          setIsOpen(!isOpen)
        }}
        className="bg-gray-700 text-white px-2 sm:px-3 py-1.5 sm:py-2 rounded-lg flex items-center justify-between gap-1 hover:bg-gray-600 active:bg-gray-600 transition w-[90px] sm:w-[110px] text-xs sm:text-sm"
      >
        <span className="font-medium truncate">{value}</span>
        <span className="text-[10px] sm:text-xs shrink-0">{isOpen ? '▲' : '▼'}</span>
      </button>

      {isOpen && (
        <>
          <div 
            className="fixed inset-0 bg-black bg-opacity-50"
            style={{ zIndex: 9998 }}
            onClick={(e) => {
              e.preventDefault()
              e.stopPropagation()
              setIsOpen(false)
            }}
            onTouchEnd={(e) => {
              e.preventDefault()
              setIsOpen(false)
            }}
          />
          
          <div 
            className="absolute top-full mt-1 bg-gray-700 rounded-lg shadow-2xl border border-gray-600 overflow-hidden w-[120px] sm:w-[140px]"
            style={{ 
              zIndex: 9999,
              right: 0
            }}
          >
            {Object.keys(TOKENS).map((token) => (
              <button
                key={token}
                type="button"
                onClick={(e) => {
                  e.preventDefault()
                  e.stopPropagation()
                  handleSelect(token as keyof typeof TOKENS)
                }}
                onTouchEnd={(e) => {
                  e.preventDefault()
                  handleSelect(token as keyof typeof TOKENS)
                }}
                className={`w-full text-left px-3 py-2 hover:bg-gray-600 active:bg-gray-500 transition border-b border-gray-600 last:border-b-0 flex items-center justify-between ${
                  value === token ? 'bg-gray-600 text-blue-400' : 'text-white'
                }`}
              >
                <span className="block text-xs sm:text-sm truncate">{token}</span>
                {value === token && <span className="text-sm shrink-0 ml-1">✓</span>}
              </button>
            ))}
          </div>
        </>
      )}
    </div>
  )
}

// Slippage Setting Component
function SlippageSetting({ slippage, setSlippage }: { slippage: number, setSlippage: (val: number) => void }) {
  const [isOpen, setIsOpen] = useState(false)
  const [customValue, setCustomValue] = useState('')

  const presetValues = [0.1, 0.5, 1.0]

  return (
    <div className="mt-2 mb-4">
      <button
        type="button"
        onClick={() => setIsOpen(!isOpen)}
        className="w-full flex items-center justify-between text-sm text-gray-400 hover:text-white transition py-2 px-3 bg-gray-800/50 rounded-lg"
      >
        <span>⚙️ Slippage Tolerance</span>
        <span className="text-blue-400 font-medium">{slippage}%</span>
      </button>

      {isOpen && (
        <div className="mt-2 p-3 bg-gray-800/50 rounded-lg border border-gray-700">
          <div className="flex gap-2 flex-wrap">
            <button
              type="button"
              onClick={() => setSlippage(0.5)}
              className={`px-4 py-2 rounded-lg font-medium transition ${
                slippage === 0.5 ? 'bg-blue-600 text-white' : 'bg-gray-700 text-gray-300 hover:bg-gray-600'
              }`}
            >
              Auto
            </button>
            {presetValues.map((val) => (
              <button
                key={val}
                type="button"
                onClick={() => setSlippage(val)}
                className={`px-4 py-2 rounded-lg font-medium transition ${
                  slippage === val ? 'bg-blue-600 text-white' : 'bg-gray-700 text-gray-300 hover:bg-gray-600'
                }`}
              >
                {val}%
              </button>
            ))}
            <div className="flex items-center gap-2 flex-1 min-w-[100px]">
              <input
                type="number"
                placeholder="Custom"
                value={customValue}
                onChange={(e) => {
                  setCustomValue(e.target.value)
                  const val = parseFloat(e.target.value)
                  if (!isNaN(val) && val > 0 && val <= 50) {
                    setSlippage(val)
                  }
                }}
                className="flex-1 px-3 py-2 bg-gray-700 text-white rounded-lg outline-none text-sm"
                step="0.1"
                min="0.1"
                max="50"
              />
              <span className="text-gray-400 text-sm">%</span>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}

export function SwapWidget() {
  const { address, isConnected } = useAccount()
  const [activeTab, setActiveTab] = useState<'swap' | 'wallet'>('swap')
  const [tokenIn, setTokenIn] = useState<keyof typeof TOKENS>('pathUSD')
  const [tokenOut, setTokenOut] = useState<keyof typeof TOKENS>('AlphaUSD')
  const [amount, setAmount] = useState('')
  const [slippage, setSlippage] = useState(0.5)
  const [txHistory, setTxHistory] = useState<Array<{ type: string, tokenIn: string, tokenOut: string, amountIn: string, amountOut: string, time: string }>>([])

  // Check allowance
  const { data: allowance, refetch: refetchAllowance } = useReadContract({
    address: TOKENS[tokenIn],
    abi: ERC20_ABI,
    functionName: 'allowance',
    args: address ? [address, DEX_ADDRESS] : undefined,
    query: {
      enabled: Boolean(address),
    },
  })

  // Get quote
  const { data: quoteData } = useReadContract({
    address: DEX_ADDRESS,
    abi: DEX_ABI,
    functionName: 'quoteSwapExactAmountIn',
    args: amount && parseFloat(amount) > 0
      ? [
          TOKENS[tokenIn],
          TOKENS[tokenOut],
          BigInt(Math.floor(parseFloat(amount) * 1e6)),
        ]
      : undefined,
    query: {
      enabled: Boolean(amount && parseFloat(amount) > 0),
    },
  })

  const { writeContract, isPending, isSuccess } = useWriteContract({
    mutation: {
      onSuccess: (hash) => {
        setTimeout(() => refetchAllowance(), 2000)
        // Add to transaction history
        const newTx = {
          type: 'Swap',
          tokenIn,
          tokenOut,
          amountIn: amount,
          amountOut: expectedOutput.toFixed(6),
          time: new Date().toLocaleTimeString(),
        }
        setTxHistory([newTx, ...txHistory])
        setAmount('')
      },
    },
  })

  const amountInWei = amount ? BigInt(Math.floor(parseFloat(amount) * 1e6)) : 0n
  const needsApproval = allowance !== undefined && amountInWei > allowance

  const handleApprove = () => {
    writeContract({
      address: TOKENS[tokenIn],
      abi: ERC20_ABI,
      functionName: 'approve',
      args: [DEX_ADDRESS, maxUint256],
    })
  }

  const handleSwap = () => {
    if (!amount || !quoteData) return
    const amountIn = BigInt(Math.floor(parseFloat(amount) * 1e6))
    const minOut = (quoteData * BigInt(Math.floor((100 - slippage) * 100))) / 10000n

    writeContract({
      address: DEX_ADDRESS,
      abi: DEX_ABI,
      functionName: 'swapExactAmountIn',
      args: [TOKENS[tokenIn], TOKENS[tokenOut], amountIn, minOut],
    })
  }

  const expectedOutput = quoteData ? Number(quoteData) / 1e6 : 0

  return (
    <div className="min-h-screen w-full bg-gradient-to-b from-gray-900 via-blue-900 to-purple-900 p-4 sm:p-6 flex flex-col items-center justify-start pt-8 sm:pt-12 pb-24">
      {/* Header */}
      <div className="w-full max-w-md mb-6 sm:mb-8 text-center">
        <h1 className="text-3xl sm:text-5xl font-bold bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent mb-2 sm:mb-3">
          Tempo DEX 🚀
        </h1>
        <p className="text-gray-400 text-sm sm:text-base">Swap stablecoins on Tempo Testnet</p>
      </div>

      {/* Main Card */}
      <div className="w-full max-w-md bg-gray-800/90 backdrop-blur-sm rounded-2xl shadow-2xl border border-gray-700 overflow-hidden">
        {/* Tabs */}
        <div className="flex border-b border-gray-700">
          <button
            onClick={() => setActiveTab('swap')}
            className={`flex-1 py-3 sm:py-4 font-bold transition ${
              activeTab === 'swap' 
                ? 'text-white bg-gray-700/50 border-b-2 border-blue-500' 
                : 'text-gray-400 hover:text-white hover:bg-gray-700/30'
            }`}
          >
            🔄 Swap
          </button>
          <button
            onClick={() => setActiveTab('wallet')}
            className={`flex-1 py-3 sm:py-4 font-bold transition ${
              activeTab === 'wallet' 
                ? 'text-white bg-gray-700/50 border-b-2 border-blue-500' 
                : 'text-gray-400 hover:text-white hover:bg-gray-700/30'
            }`}
          >
            👛 Wallet
          </button>
        </div>

        <div className="p-4 sm:p-6">
          {activeTab === 'swap' ? (
            <>
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-lg sm:text-xl font-bold text-white">Swap</h2>
                <div className="scale-90 sm:scale-100 origin-right">
                  <ConnectButton />
                </div>
              </div>

              {isConnected ? (
                <div className="space-y-3 sm:space-y-4">
                  {/* From Token */}
                  <div className="bg-gray-900/50 p-3 sm:p-4 rounded-xl border border-gray-700">
                    <label className="text-xs sm:text-sm text-gray-400 block mb-2">From</label>
                    <div className="flex gap-2 items-center">
                      <input
                        type="number"
                        placeholder="0.0"
                        value={amount}
                        onChange={(e) => setAmount(e.target.value)}
                        className="flex-1 bg-transparent text-lg sm:text-xl text-white outline-none min-w-0"
                        step="any"
                      />
                      <TokenSelect 
                        value={tokenIn} 
                        onChange={setTokenIn} 
                        label="From"
                      />
                    </div>
                  </div>

                  {/* Swap Arrow Button */}
                  <div className="flex justify-center -my-1 sm:-my-2 relative z-10">
                    <button
                      type="button"
                      onClick={() => { 
                        const temp = tokenIn
                        setTokenIn(tokenOut)
                        setTokenOut(temp)
                      }}
                      className="bg-gray-700 p-2 rounded-full border-4 border-gray-800 hover:bg-gray-600 active:bg-gray-600 transition text-base sm:text-lg"
                    >
                      🔄
                    </button>
                  </div>

                  {/* To Token */}
                  <div className="bg-gray-900/50 p-3 sm:p-4 rounded-xl border border-gray-700">
                    <label className="text-xs sm:text-sm text-gray-400 block mb-2">To</label>
                    <div className="flex gap-2 items-center">
                      <input
                        type="text"
                        value={expectedOutput > 0 ? expectedOutput.toFixed(6) : '0.0'}
                        readOnly
                        className="flex-1 bg-transparent text-lg sm:text-xl text-white outline-none min-w-0"
                      />
                      <TokenSelect 
                        value={tokenOut} 
                        onChange={setTokenOut} 
                        label="To"
                      />
                    </div>
                  </div>

                  {/* Slippage Setting */}
                  <SlippageSetting slippage={slippage} setSlippage={setSlippage} />

                  {/* Action Button */}
                  {needsApproval ? (
                    <button
                      type="button"
                      onClick={handleApprove}
                      disabled={isPending || !amount || parseFloat(amount) <= 0}
                      className="w-full bg-yellow-600 hover:bg-yellow-700 active:bg-yellow-700 disabled:bg-gray-700 disabled:text-gray-500 text-white font-bold py-3 sm:py-4 rounded-xl transition text-sm sm:text-base"
                    >
                      {isPending ? '⏳ Approving...' : `🔓 Approve ${tokenIn}`}
                    </button>
                  ) : (
                    <button
                      type="button"
                      onClick={handleSwap}
                      disabled={!amount || isPending || parseFloat(amount) <= 0 || tokenIn === tokenOut}
                      className="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-700 disabled:bg-gray-700 disabled:text-gray-500 text-white font-bold py-3 sm:py-4 rounded-xl transition text-sm sm:text-base"
                    >
                      {isPending ? '⏳ Swapping...' : isSuccess ? '✅ Success!' : 'Swap'}
                    </button>
                  )}

                  {/* Info */}
                  {allowance !== undefined && (
                    <p className="text-xs text-gray-500 text-center pt-1">
                      Allowance: {(Number(allowance) / 1e6).toFixed(2)} {tokenIn}
                    </p>
                  )}
                </div>
              ) : (
                <div className="text-center py-8 sm:py-12 text-gray-400">
                  <p className="text-2xl sm:text-3xl mb-3">👛</p>
                  <p className="text-sm sm:text-base">Connect wallet to start swapping</p>
                </div>
              )}
            </>
          ) : (
            <>
              {/* Wallet Tab */}
              {isConnected && address ? (
                <div className="space-y-4">
                  {/* Assets Section */}
                  <div>
                    <h3 className="text-white font-bold text-lg mb-3 flex items-center gap-2">
                      💰 My Assets
                    </h3>
                    <div className="space-y-2">
                      {Object.entries(TOKENS).map(([name, addr]) => (
                        <TokenBalance key={name} address={address} tokenAddress={addr} tokenName={name} />
                      ))}
                    </div>
                  </div>

                  {/* Transaction History */}
                  <div className="mt-6">
                    <h3 className="text-white font-bold text-lg mb-3 flex items-center gap-2">
                      📜 Recent Transactions
                    </h3>
                    {txHistory.length > 0 ? (
                      <div className="space-y-2 max-h-[300px] overflow-y-auto">
                        {txHistory.map((tx, idx) => (
                          <div key={idx} className="p-3 bg-gray-800/50 rounded-lg border border-gray-700">
                            <div className="flex justify-between items-start mb-1">
                              <span className="text-blue-400 font-medium text-sm">{tx.type}</span>
                              <span className="text-gray-400 text-xs">{tx.time}</span>
                            </div>
                            <div className="text-xs text-gray-300">
                              <p>{tx.amountIn} {tx.tokenIn} → {tx.amountOut} {tx.tokenOut}</p>
                            </div>
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div className="text-center py-8 text-gray-400">
                        <p className="text-2xl mb-2">📭</p>
                        <p className="text-sm">No transactions yet</p>
                      </div>
                    )}
                  </div>
                </div>
              ) : (
                <div className="text-center py-12 text-gray-400">
                  <p className="text-3xl mb-3">🔒</p>
                  <p className="mb-4">Connect your wallet to view assets</p>
                  <ConnectButton />
                </div>
              )}
            </>
          )}
        </div>
      </div>

      {/* Footer Info */}
      <div className="mt-6 text-center text-gray-500 text-xs">
        <p>Tempo DEX • Testnet Only</p>
      </div>
    </div>
  )
}